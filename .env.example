# =====================================================================
# DataPulse AI — Environment Configuration
# Exasol Personal + FastAPI + React
# =====================================================================

# Exasol Personal Database Connection Details
# Default Exasol Personal port is typically 8563 (or as reported by `exasol status` / `exakit info`)
EXASOL_DSN=localhost:8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=DATAPULSE
EXASOL_VERIFY_TLS=False
EXASOL_ENABLED=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: LLM Integration (Leave blank for deterministic rule-based explanations)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
